@using eMeetup.App.Shared.Models
@using eMeetup.App.Shared.Services
@inject IActivityService ActivityService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

@if (_isLoading)
{
    <div Style="text-align:center; padding:20px;">
        <p>⏳ Загрузка чата...</p>
    </div>
}
else if (!_isAuthenticated)
{
    <div Style="padding:12px; background:#fff3cd; color:#856404; border-radius:4px; border:1px solid #ffeeba;">
        ⚠️ <a href="/login" Style="color:#0078D4;">Войдите</a> чтобы участвовать в чате
    </div>
}
else
{
    <div>
        <!-- Сообщения -->
        <div Style="height:300px; overflow-y:auto; padding:16px;" id="chatMessages">
            @if (!_messages.Any())
            {
                <div Style="text-align:center; color:#6c757d; padding:20px;">
                    <p>📭 Пока нет сообщений</p>
                    <p Style="font-size:0.85rem;">Будьте первым, кто напишет!</p>
                </div>
            }
            else
            {
                @foreach (var message in _messages)
                {
                    <div Style="display:flex; gap:10px; margin-bottom:12px;">
                        <div>
                            @if (!string.IsNullOrEmpty(message.AvatarUrl))
                            {
                                <img src="@message.AvatarUrl" Style="width:36px; height:36px; border-radius:50%; object-fit:cover;" />
                            }
                            else
                            {
                                <div Style="width:36px; height:36px; border-radius:50%; background:#0078D4; color:white; display:flex; align-items:center; justify-content:center; font-size:16px;">
                                    @(message.Username.Substring(0, 1).ToUpper())
                                </div>
                            }
                        </div>
                        <div Style="flex:1;">
                            <div Style="display:flex; gap:8px; align-items:center; margin-bottom:4px;">
                                <strong>@message.Username</strong>
                                <span Style="font-size:0.7rem; color:#6c757d;">@message.SentAt.ToString("HH:mm")</span>
                                @if (message.IsEdited)
                                {
                                    <span Style="font-size:0.7rem; color:#6c757d; font-style:italic;">(изменено)</span>
                                }
                                @if (_currentUser?.Id == message.UserId)
                                {
                                    <button @onclick="() => StartEdit(message)" Style="background:none; border:none; color:#0078D4; cursor:pointer; font-size:0.7rem; padding:0 4px;">
                                        ✏️
                                    </button>
                                    <button @onclick="() => DeleteMessage(message.Id)" Style="background:none; border:none; color:#dc3545; cursor:pointer; font-size:0.7rem; padding:0 4px;">
                                        🗑️
                                    </button>
                                }
                            </div>
                            @if (_editingMessageId == message.Id)
                            {
                                <div Style="display:flex; gap:8px;">
                                    <input @bind="_editText"
                                           placeholder="Редактировать сообщение..."
                                           Style="flex:1; padding:6px 10px; border:1px solid #ced4da; border-radius:4px;" />
                                    <button @onclick="SaveEdit" Style="padding:6px 16px; background:#28a745; color:white; border:none; border-radius:4px; cursor:pointer;">
                                        💾
                                    </button>
                                    <button @onclick="CancelEdit" Style="padding:6px 16px; background:#6c757d; color:white; border:none; border-radius:4px; cursor:pointer;">
                                        ✕
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div Style="background:#f8f9fa; padding:8px 12px; border-radius:8px; word-wrap:break-word;">
                                    @message.Message
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            <div id="chatEnd"></div>
        </div>

        <!-- Ввод сообщения -->
        @if (_canSendMessages)
        {
            <div Style="padding:12px 16px; border-top:1px solid #dee2e6; background:#f8f9fa;">
                <div Style="display:flex; gap:8px;">
                    <input @bind="_newMessage"
                           placeholder="Напишите сообщение..."
                           Style="flex:1; padding:8px 12px; border:1px solid #ced4da; border-radius:20px; outline:none;"
                           @onkeydown="OnEnterKey" />
                    <button @onclick="SendMessage" disabled="@_isSending" Style="padding:8px 20px; background:#0078D4; color:white; border:none; border-radius:20px; cursor:pointer;">
                        @if (_isSending)
                        {
                            <span>⏳</span>
                        }
                        else
                        {
                            <span>📤</span>
                        }
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int InstanceId { get; set; }

    private List<ChatMessage> _messages = new();
    private string _newMessage = string.Empty;
    private string _editText = string.Empty;
    private int _editingMessageId = 0;
    private bool _isLoading = true;
    private bool _isSending;
    private bool _isAuthenticated;
    private bool _canSendMessages;
    private User? _currentUser;
    private System.Threading.Timer? _timer;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (_isAuthenticated)
        {
            _currentUser = await AuthService.GetCurrentUserAsync();

            var instance = await ActivityService.GetInstanceAsync(InstanceId);
            if (instance != null && _currentUser != null)
            {
                var template = await ActivityService.GetTemplateAsync(instance.TemplateId);
                _canSendMessages = instance.Participants.Any(p => p.Id == _currentUser.Id) ||
                                  (template != null && template.OrganizerId == _currentUser.Id);
            }
        }

        await LoadMessages();
        _isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ScrollToBottom();

            // Запускаем таймер с InvokeAsync для обновления UI
            _timer = new Timer(async _ =>
            {
                try
                {
                    // Обновляем сообщения в потоке Dispatcher
                    await InvokeAsync(async () =>
                    {
                        await LoadMessages();
                        StateHasChanged();
                    });
                }
                catch (Exception ex)
                {
                    System.Diagnostics.Debug.WriteLine($"Timer error: {ex.Message}");
                }
            }, null, 5000, 5000);
        }
    }

    private async Task LoadMessages()
    {
        try
        {
            _messages = await ActivityService.GetChatMessagesAsync(InstanceId);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading messages: {ex.Message}");
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_newMessage) || _isSending || !_canSendMessages) return;

        _isSending = true;
        try
        {
            var result = await ActivityService.SendChatMessageAsync(InstanceId, _currentUser!.Id, _newMessage);
            if (result != null)
            {
                _newMessage = string.Empty;
                await LoadMessages();
                await ScrollToBottom();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error sending message: {ex.Message}");
        }
        finally
        {
            _isSending = false;
        }
    }

    private void OnEnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newMessage))
        {
            SendMessage();
        }
    }

    private void StartEdit(ChatMessage message)
    {
        _editingMessageId = message.Id;
        _editText = message.Message;
        StateHasChanged();
    }

    private async Task SaveEdit()
    {
        if (string.IsNullOrWhiteSpace(_editText) || _editingMessageId == 0) return;

        var result = await ActivityService.EditChatMessageAsync(_editingMessageId, _currentUser!.Id, _editText);
        if (result)
        {
            _editingMessageId = 0;
            _editText = string.Empty;
            await LoadMessages();
            StateHasChanged();
        }
    }

    private void CancelEdit()
    {
        _editingMessageId = 0;
        _editText = string.Empty;
        StateHasChanged();
    }

    private async Task DeleteMessage(int messageId)
    {
        if (!await ConfirmDelete()) return;

        var result = await ActivityService.DeleteChatMessageAsync(messageId, _currentUser!.Id);
        if (result)
        {
            await LoadMessages();
            StateHasChanged();
        }
    }

    private async Task<bool> ConfirmDelete()
    {
        return await Task.FromResult(true);
    }

    private async Task ScrollToBottom()
    {
        await Task.Delay(100);
        try
        {
            await JSRuntime.InvokeVoidAsync("scrollToBottom", "chatMessages");
        }
        catch { }
    }

    public void Dispose()
    {
        if (!_disposed)
        {
            _timer?.Dispose();
            _disposed = true;
        }
    }
}