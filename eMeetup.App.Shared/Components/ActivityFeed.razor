@using eMeetup.App.Shared.Models
@using eMeetup.App.Shared.Services
@inject IAuthService AuthService
@inject IActivityService ActivityService

@if (_isLoading)
{
    <div Style="display:flex; justify-content:center; padding:40px;">
        <div Style="width:40px; height:40px; border:4px solid #e9ecef; border-top-color:#0078D4; border-radius:50%; animation:spin 1s linear infinite;"></div>
        <style>
                @@keyframes spin {
                    to {
                        transform: rotate(360deg);
                    }
                }
        </style>
    </div>
}
else if (!_isAuthenticated)
{
    <div Style="padding:12px; background:#fff3cd; color:#856404; border-radius:4px; border:1px solid #ffeeba;">
        ⚠️ Пожалуйста, <a href="/login" Style="color:#0078D4;">войдите</a> для просмотра активностей
    </div>
}
else if (!_instances.Any())
{
    <div Style="border:1px solid #dee2e6; border-radius:8px; padding:20px; text-align:center; background:white;">
        <div Style="font-size:48px;">📭</div>
        <h5>Нет активностей</h5>
        <p Style="color: #6c757d;">
            Создайте шаблон и добавьте расписание!
        </p>
        <div Style="display:flex; gap:8px; justify-content:center;">
            <a href="/create-template" Style="display:inline-block; padding:8px 16px; background:#0078D4; color:white; border-radius:4px; text-decoration:none;">
                📝 Создать шаблон
            </a>
        </div>
    </div>
}
else
{
    <div Style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:16px;">
        @foreach (var instance in _instances)
        {
            <ActivityCard Instance="instance"
                          OnJoinClicked="@(() => JoinInstance(instance.Id))"
                          OnLeaveClicked="@(() => LeaveInstance(instance.Id))" />
        }
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<ActivityInstance> _instances = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var allInstances = await ActivityService.GetInstancesAsync();
                _instances = allInstances
                    .Where(i => i.Status != "Cancelled" && i.Status != "Completed")
                    .OrderBy(i => i.StartTime)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading instances: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task JoinInstance(int instanceId)
    {
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user == null) return;

            var result = await ActivityService.JoinInstanceAsync(instanceId, user.Id);
            if (result)
            {
                _instances = (await ActivityService.GetInstancesAsync())
                    .Where(i => i.Status != "Cancelled" && i.Status != "Completed")
                    .OrderBy(i => i.StartTime)
                    .ToList();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error joining instance: {ex.Message}");
        }
    }

    private async Task LeaveInstance(int instanceId)
    {
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user == null) return;

            var result = await ActivityService.LeaveInstanceAsync(instanceId, user.Id);
            if (result)
            {
                _instances = (await ActivityService.GetInstancesAsync())
                    .Where(i => i.Status != "Cancelled" && i.Status != "Completed")
                    .OrderBy(i => i.StartTime)
                    .ToList();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error leaving instance: {ex.Message}");
        }
    }
}