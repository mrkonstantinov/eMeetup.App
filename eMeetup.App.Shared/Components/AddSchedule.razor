@using eMeetup.App.Shared.Models
@using eMeetup.App.Shared.Services
@inject IActivityService ActivityService
@inject NavigationManager Navigation

@if (_template == null)
{
    <div Style="padding:12px; background:#f8d7da; color:#721c24; border-radius:4px; border:1px solid #f5c6cb;">
        ❌ Шаблон не найден
    </div>
    return;
}

<div Style="max-width:600px; margin:0 auto; background:white; padding:24px; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,0.1);">
    <h3>📅 Добавить встречу</h3>
    <p Style="color:#6c757d; font-size:0.9rem;">
        Шаблон: <strong>@_template.Title</strong>
    </p>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div Style="padding:12px; background:#f8d7da; color:#721c24; border-radius:4px; border:1px solid #f5c6cb; margin-bottom:16px;">
            ❌ @_errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div Style="padding:12px; background:#d4edda; color:#155724; border-radius:4px; border:1px solid #c3e6cb; margin-bottom:16px;">
            ✅ @_successMessage
        </div>
    }

    <div Style="margin-bottom:16px;">
        <label Style="display:block; margin-bottom:4px; font-weight:500;">📅 Дата и время *</label>
        <div Style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
            <input @bind="_instance.StartTime" type="datetime-local" Style="padding:8px; border:1px solid #ced4da; border-radius:4px;" />
            <input @bind="_instance.EndTime" type="datetime-local" Style="padding:8px; border:1px solid #ced4da; border-radius:4px;" />
        </div>
    </div>

    <div Style="margin-bottom:16px;">
        <label Style="display:block; margin-bottom:4px; font-weight:500;">📍 Место (оставьте пустым для использования из шаблона)</label>
        <input @bind="_instance.Location" Style="width:100%; padding:8px; border:1px solid #ced4da; border-radius:4px;" placeholder="Или укажите другое место" />
    </div>

    <div Style="margin-bottom:16px;">
        <label Style="display:block; margin-bottom:4px; font-weight:500;">👥 Макс. участников (оставьте пустым для использования из шаблона)</label>
        <input @bind="_instance.MaxParticipants" type="number" min="1" max="100" Style="width:100%; padding:8px; border:1px solid #ced4da; border-radius:4px;" />
    </div>

    <div Style="margin-bottom:16px;">
        <label Style="display:block; margin-bottom:4px; font-weight:500;">📝 Заметки для этой встречи</label>
        <textarea @bind="_instance.Notes" Style="width:100%; padding:8px; border:1px solid #ced4da; border-radius:4px; min-height:60px;"
                  placeholder="Особые условия для этой встречи..."></textarea>
    </div>

    <div Style="display:flex; gap:12px;">
        <button @onclick="AddInstance" disabled="@_isSubmitting" Style="flex:1; padding:10px; background:#28a745; color:white; border:none; border-radius:4px; cursor:pointer;">
            @if (_isSubmitting)
            {
                <span>⏳ Добавление...</span>
            }
            else
            {
                <span>✅ Добавить встречу</span>
            }
        </button>
        <a href="/template/@_template.Id" Style="display:inline-block; padding:10px 20px; border:1px solid #6c757d; color:#6c757d; border-radius:4px; text-decoration:none;">
            Отмена
        </a>
    </div>
</div>

@code {
    [Parameter] public int TemplateId { get; set; }

    private ActivityTemplate? _template;
    private ActivityInstance _instance = new()
    {
        StartTime = DateTime.Now.AddDays(7),
        EndTime = DateTime.Now.AddDays(7).AddHours(2),
        Status = "Scheduled",
        Participants = new List<User>()
    };

    private bool _isSubmitting;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _template = await ActivityService.GetTemplateAsync(TemplateId);
            if (_template != null)
            {
                _instance.TemplateId = _template.Id;
                _instance.MaxParticipants = _template.MaxParticipants;
                _instance.Location = _template.Location;
            }
        }
        catch
        {
            _errorMessage = "Ошибка загрузки шаблона";
        }
    }

    private async Task AddInstance()
    {
        if (_instance.StartTime >= _instance.EndTime)
        {
            _errorMessage = "❌ Время начала должно быть раньше времени окончания";
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            _instance.TemplateId = TemplateId;
            _instance.CreatedAt = DateTime.Now;
            _instance.UpdatedAt = DateTime.Now;

            var result = await ActivityService.CreateInstanceAsync(_instance);
            _successMessage = $"✅ Встреча добавлена! {result.StartTime:dd.MM.yyyy HH:mm}";

            _instance = new ActivityInstance
            {
                TemplateId = TemplateId,
                StartTime = DateTime.Now.AddDays(7),
                EndTime = DateTime.Now.AddDays(7).AddHours(2),
                Status = "Scheduled",
                MaxParticipants = _template?.MaxParticipants,
                Location = _template?.Location,
                Participants = new List<User>()
            };

            StateHasChanged();
        }
        catch (Exception ex)
        {
            _errorMessage = $"⚠️ Ошибка: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}