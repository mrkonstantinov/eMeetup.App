@using eMeetup.App.Shared.Models.Auth
@using eMeetup.App.Shared.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div Style="max-width: 480px; margin: 0 auto; padding-top: 40px;">
    <div Style="background:white; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,0.1); padding:32px;">
        <div Style="text-align:center; margin-bottom:24px;">
            <div Style="font-size:48px;">📝</div>
            <h3 Style="margin:8px 0 0 0;">Регистрация</h3>
            <p Style="color: var(--neutral-fill-strong); margin:4px 0 0 0;">
                Создайте новый аккаунт
            </p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div Style="padding:12px; background:#f8d7da; color:#721c24; border-radius:4px; border:1px solid #f5c6cb; margin-bottom:16px;">
                ❌ @_errorMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div Style="padding:12px; background:#d4edda; color:#155724; border-radius:4px; border:1px solid #c3e6cb; margin-bottom:16px;">
                ✅ @_successMessage
            </div>
        }

        <div Style="margin-bottom:16px;">
            <label Style="display:block; margin-bottom:4px; font-weight:500;">Имя пользователя *</label>
            <input @bind="_request.UserName"
                   Style="width:100%; padding:10px; border:1px solid #ced4da; border-radius:4px;"
                   placeholder="Введите имя пользователя" />
        </div>

        <div Style="margin-bottom:16px;">
            <label Style="display:block; margin-bottom:4px; font-weight:500;">Email *</label>
            <input @bind="_request.Email"
                   type="email"
                   Style="width:100%; padding:10px; border:1px solid #ced4da; border-radius:4px;"
                   placeholder="example@email.com" />
        </div>

        <div Style="margin-bottom:16px;">
            <label Style="display:block; margin-bottom:4px; font-weight:500;">Пароль *</label>
            <input @bind="_request.Password"
                   type="password"
                   Style="width:100%; padding:10px; border:1px solid #ced4da; border-radius:4px;"
                   placeholder="Минимум 8 символов" />
        </div>

        <div Style="margin-bottom:16px;">
            <label Style="display:block; margin-bottom:4px; font-weight:500;">Подтвердите пароль *</label>
            <input @bind="_confirmPassword"
                   type="password"
                   Style="width:100%; padding:10px; border:1px solid #ced4da; border-radius:4px;"
                   placeholder="Повторите пароль" />
        </div>

        <button @onclick="HandleRegister" disabled="@_isLoading"
                Style="width:100%; padding:12px; background:#0078D4; color:white; border:none; border-radius:4px; cursor:pointer; font-size:16px; font-weight:500;">
            @if (_isLoading)
            {
                <span>⏳ Регистрация...</span>
            }
            else
            {
                <span>✅ Зарегистрироваться</span>
            }
        </button>

        <hr Style="margin:20px 0; border:none; border-top:1px solid #dee2e6;" />

        <p Style="text-align:center; margin:0;">
            Уже есть аккаунт?
            <a href="/login" Style="color:#0078D4; text-decoration:none;">Войти</a>
        </p>
    </div>
</div>

@code {
    private RegisterRequest _request = new();
    private string _confirmPassword = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isLoading;

    private async Task HandleRegister()
    {
        // Валидация
        if (string.IsNullOrWhiteSpace(_request.UserName))
        {
            _errorMessage = "Введите имя пользователя";
            return;
        }
        if (string.IsNullOrWhiteSpace(_request.Email) || !_request.Email.Contains("@"))
        {
            _errorMessage = "Введите корректный email";
            return;
        }
        if (string.IsNullOrWhiteSpace(_request.Password) || _request.Password.Length < 8)
        {
            _errorMessage = "Пароль должен содержать минимум 8 символов";
            return;
        }
        if (_request.Password != _confirmPassword)
        {
            _errorMessage = "Пароли не совпадают";
            return;
        }

        _isLoading = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var result = await AuthService.RegisterAsync(_request);

            if (result.Success)
            {
                _successMessage = "✅ Регистрация успешна! Перенаправление...";
                await Task.Delay(1000);
                Navigation.NavigateTo("/", true);
            }
            else
            {
                _errorMessage = result.Error ?? "Ошибка регистрации";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}