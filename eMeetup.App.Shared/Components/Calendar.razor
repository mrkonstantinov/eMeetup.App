@using eMeetup.App.Shared.Models
@using eMeetup.App.Shared.Services
@inject IActivityService ActivityService
@inject IAuthService AuthService
@inject NavigationManager Navigation

@if (_isLoading)
{
    <div Style="text-align:center; padding:40px;">
        <p>⏳ Загрузка календаря...</p>
    </div>
}
else if (!_isAuthenticated)
{
    <div Style="padding:12px; background:#fff3cd; color:#856404; border-radius:4px; border:1px solid #ffeeba;">
        ⚠️ <a href="/login" Style="color:#0078D4;">Войдите</a> чтобы увидеть календарь
    </div>
}
else if (!_instances.Any())
{
    <div Style="border:1px solid #dee2e6; border-radius:8px; padding:40px; text-align:center; background:white;">
        <div Style="font-size:48px;">📅</div>
        <h4>Нет запланированных встреч</h4>
        <p Style="color:#6c757d;">Создайте шаблон и добавьте встречи!</p>
        <a href="/create-template" Style="display:inline-block; padding:10px 24px; background:#0078D4; color:white; border-radius:4px; text-decoration:none; margin-top:12px;">
            📝 Создать шаблон
        </a>
    </div>
}
else
{
    <div Style="background:white; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,0.05); overflow:hidden;">
        <!-- Заголовок календаря -->
        <div Style="padding:16px 20px; background:#f8f9fa; border-bottom:1px solid #dee2e6;">
            <div Style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                <button @onclick="PrevMonth" Style="background:none; border:none; font-size:1.5rem; cursor:pointer; padding:4px 8px;">◀</button>
                <h4 Style="margin:0; font-size:1.2rem;">@_currentMonth.ToString("MMMM yyyy")</h4>
                <button @onclick="NextMonth" Style="background:none; border:none; font-size:1.5rem; cursor:pointer; padding:4px 8px;">▶</button>
                <button @onclick="GoToToday" Style="padding:6px 16px; background:#0078D4; color:white; border:none; border-radius:4px; cursor:pointer; font-size:0.85rem;">
                    📅 Сегодня
                </button>
            </div>
        </div>

        <!-- Сетка календаря -->
        <div Style="padding:12px;">
            <!-- Дни недели -->
            <div Style="display:grid; grid-template-columns:repeat(7, 1fr); gap:4px; margin-bottom:8px;">
                @foreach (var day in _daysOfWeek)
                {
                    <div Style="text-align:center; font-weight:bold; color:#6c757d; padding:8px; font-size:0.85rem;">
                        @day
                    </div>
                }
            </div>

            <!-- Дни месяца -->
            <div Style="display:grid; grid-template-columns:repeat(7, 1fr); gap:4px;">
                @foreach (var day in _calendarDays)
                {
                    var dayInstances = _instances.Where(i => i.StartTime.Date == day.Date && i.Status != "Cancelled").ToList();
                    var isToday = day.Date == DateTime.Today;

                    <div Style="border:1px solid @(day.IsCurrentMonth ? "#dee2e6" : "#f1f1f1");
                        border-radius:6px; padding:6px; min-height:70px;
                        background: @(isToday ? "#e3f2fd" : "white");
                        @(day.IsCurrentMonth ? "" : "opacity:0.4;")
                        transition: all 0.2s;"
                         onmouseover="this.style.boxShadow='0 2px 8px rgba(0,0,0,0.1)'"
                         onmouseout="this.style.boxShadow='none'">
                        <div Style="display:flex; justify-content:space-between; align-items:center;">
                            <span Style="font-weight:@(isToday ? "bold" : "normal");
                                color:@(isToday ? "#0078D4" : "inherit");
                                font-size:0.9rem;">
                                @day.Day
                            </span>
                            @if (dayInstances.Any())
                            {
                                <span Style="font-size:0.7rem; background:#28a745; color:white;
                                    padding:1px 6px; border-radius:10px;">
                                    @dayInstances.Count
                                </span>
                            }
                        </div>
                        <div Style="margin-top:4px;">
                            @foreach (var instance in dayInstances.Take(2))
                            {
                                <a href="/activity-instance/@instance.Id"
                                   Style="display:block; font-size:0.65rem; padding:2px 4px;
                                    background:#d4edda; border-radius:2px; margin-bottom:2px;
                                    color:#155724; text-decoration:none;
                                    overflow:hidden; white-space:nowrap; text-overflow:ellipsis;
                                    transition: all 0.2s;"
                                   onmouseover="this.style.background='#c3e6cb'"
                                   onmouseout="this.style.background='#d4edda'">
                                    @instance.StartTime.ToString("HH:mm")
                                    @(instance.Template?.Title?.Length > 15 ? instance.Template.Title.Substring(0, 15) + "..." : instance.Template?.Title)
                                </a>
                            }
                            @if (dayInstances.Count > 2)
                            {
                                <div Style="font-size:0.6rem; color:#6c757d; padding:2px 4px;">
                                    +@(dayInstances.Count - 2) еще
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Легенда -->
        <div Style="padding:12px 20px; background:#f8f9fa; border-top:1px solid #dee2e6; display:flex; gap:16px; flex-wrap:wrap; font-size:0.8rem;">
            <div Style="display:flex; align-items:center; gap:6px;">
                <div Style="width:16px; height:16px; background:#d4edda; border-radius:2px;"></div>
                <span>Есть встречи</span>
            </div>
            <div Style="display:flex; align-items:center; gap:6px;">
                <div Style="width:16px; height:16px; background:#e3f2fd; border-radius:2px; border:1px solid #0078D4;"></div>
                <span>Сегодня</span>
            </div>
            <div Style="display:flex; align-items:center; gap:6px;">
                <div Style="width:16px; height:16px; background:#f8f9fa; border-radius:2px; border:1px solid #dee2e6; opacity:0.4;"></div>
                <span>Другой месяц</span>
            </div>
            @if (_instances.Count > 0)
            {
                <div Style="display:flex; align-items:center; gap:6px; margin-left:auto;">
                    <span>Всего встреч: <strong>@_instances.Count</strong></span>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int? UserId { get; set; }

    private bool _isLoading = true;
    private bool _isAuthenticated;
    private DateTime _currentMonth = DateTime.Now;
    private List<ActivityInstance> _instances = new();
    private List<ActivityInstance> _allInstances = new();
    private string[] _daysOfWeek = { "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс" };
    private List<CalendarDay> _calendarDays = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        BuildCalendar();
        _isLoading = false;
    }

    private async Task LoadData()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var user = await AuthService.GetCurrentUserAsync();
                if (user != null)
                {
                    _allInstances = await ActivityService.GetInstancesAsync();

                    // Если UserId не указан, показываем встречи текущего пользователя
                    var targetUserId = UserId ?? user.Id;

                    _instances = _allInstances
                                            .Where(i => i.Participants.Any(p => p.Id == targetUserId) ||
                                                        (i.Template != null && i.Template.OrganizerId == targetUserId))
                                            .OrderBy(i => i.StartTime)
                                            .ToList();
                }
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Calendar error: {ex.Message}");
        }
    }

    private void BuildCalendar()
    {
        _calendarDays = new List<CalendarDay>();

        var firstDay = new DateTime(_currentMonth.Year, _currentMonth.Month, 1);
        var lastDay = firstDay.AddMonths(1).AddDays(-1);

        // Начинаем с понедельника
        var startDate = firstDay.AddDays(-((int)firstDay.DayOfWeek == 0 ? 6 : (int)firstDay.DayOfWeek - 1));
        var endDate = lastDay.AddDays(((int)lastDay.DayOfWeek == 0 ? 0 : 7 - (int)lastDay.DayOfWeek));

        for (var date = startDate; date <= endDate; date = date.AddDays(1))
        {
            _calendarDays.Add(new CalendarDay
            {
                Date = date,
                Day = date.Day,
                IsCurrentMonth = date.Month == _currentMonth.Month
            });
        }
    }

    private async Task PrevMonth()
    {
        _currentMonth = _currentMonth.AddMonths(-1);
        BuildCalendar();
        await LoadData();
        StateHasChanged();
    }

    private async Task NextMonth()
    {
        _currentMonth = _currentMonth.AddMonths(1);
        BuildCalendar();
        await LoadData();
        StateHasChanged();
    }

    private async Task GoToToday()
    {
        _currentMonth = DateTime.Now;
        BuildCalendar();
        await LoadData();
        StateHasChanged();
    }

    public class CalendarDay
    {
        public DateTime Date { get; set; }
        public int Day { get; set; }
        public bool IsCurrentMonth { get; set; }
    }
}