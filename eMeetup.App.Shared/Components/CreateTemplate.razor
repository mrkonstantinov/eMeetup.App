@using eMeetup.App.Shared.Models
@using eMeetup.App.Shared.Services
@inject IActivityService ActivityService
@inject IAuthService AuthService
@inject NavigationManager Navigation

@if (!_isAuthenticated)
{
    <div Style="padding:12px; background:#fff3cd; color:#856404; border-radius:4px; border:1px solid #ffeeba;">
        ⚠️ Пожалуйста, <a href="/login" Style="color:#0078D4;">войдите</a> для создания шаблона активности
    </div>
    return;
}

<div Style="max-width:600px; margin:0 auto; background:white; padding:24px; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,0.1);">
    <h3>📝 Создать шаблон активности</h3>
    <p Style="color:#6c757d; font-size:0.9rem;">Создайте шаблон, чтобы затем добавить расписание встреч</p>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div Style="padding:12px; background:#f8d7da; color:#721c24; border-radius:4px; border:1px solid #f5c6cb; margin-bottom:16px;">
            ❌ @_errorMessage
        </div>
    }

    <!-- Название -->
    <div Style="margin-bottom:16px;">
        <label Style="display:block; margin-bottom:4px; font-weight:500;">Название *</label>
        <input @bind="_template.Title" Style="width:100%; padding:8px; border:1px solid #ced4da; border-radius:4px;" placeholder="Например: Еженедельный поход в горы" />
    </div>

    <!-- Описание -->
    <div Style="margin-bottom:16px;">
        <label Style="display:block; margin-bottom:4px; font-weight:500;">Описание *</label>
        <textarea @bind="_template.Description" Style="width:100%; padding:8px; border:1px solid #ced4da; border-radius:4px; min-height:80px;"
                  placeholder="Опишите активность, что нужно взять, какие навыки требуются..."></textarea>
    </div>

    <!-- Тип -->
    <div Style="margin-bottom:16px;">
        <label Style="display:block; margin-bottom:4px; font-weight:500;">Тип активности</label>
        <select @bind="_template.Type" Style="width:100%; padding:8px; border:1px solid #ced4da; border-radius:4px;">
            <option value="Cycling">🚴 Вело</option>
            <option value="Hiking">🥾 Поход</option>
            <option value="Bar">🍺 Бар</option>
            <option value="Coffee">☕ Кофе</option>
            <option value="BoardGames">🎲 Настолки</option>
            <option value="Other">📌 Другое</option>
        </select>
    </div>

    <!-- Место -->
    <div Style="margin-bottom:16px;">
        <label Style="display:block; margin-bottom:4px; font-weight:500;">Место *</label>
        <input @bind="_template.Location" Style="width:100%; padding:8px; border:1px solid #ced4da; border-radius:4px;" placeholder="Где обычно проходит?" />
    </div>

    <!-- Теги -->
    <div Style="margin-bottom:16px;">
        <label Style="display:block; margin-bottom:4px; font-weight:500;">🏷️ Теги</label>
        <div Style="display:flex; gap:8px;">
            <input @bind="_tagsInput" placeholder="спорт, природа, активный" Style="flex:1; padding:8px; border:1px solid #ced4da; border-radius:4px;" />
            <button @onclick="AddTag" Style="padding:8px 16px; background:#0078D4; color:white; border:none; border-radius:4px; cursor:pointer;">Добавить</button>
        </div>
        @if (_template.Tags.Any())
        {
            <div Style="display:flex; flex-wrap:wrap; gap:6px; margin-top:8px;">
                @foreach (var tag in _template.Tags)
                {
                    <span Style="display:inline-block; padding:4px 12px; background:#0078D4; color:white; border-radius:20px; font-size:0.85rem;">
                        #@tag
                        <button @onclick="() => RemoveTag(tag)" Style="background:none; border:none; cursor:pointer; margin-left:4px; color:white;">×</button>
                    </span>
                }
            </div>
        }
    </div>

    <!-- Макс. участников -->
    <div Style="margin-bottom:16px;">
        <label Style="display:block; margin-bottom:4px; font-weight:500;">Макс. участников</label>
        <input @bind="_template.MaxParticipants" type="number" min="1" max="100" Style="width:100%; padding:8px; border:1px solid #ced4da; border-radius:4px;" />
    </div>

    <!-- Сложность -->
    <div Style="margin-bottom:16px;">
        <label Style="display:block; margin-bottom:4px; font-weight:500;">Сложность</label>
        <select @bind="_template.Difficulty" Style="width:100%; padding:8px; border:1px solid #ced4da; border-radius:4px;">
            <option value="">Не указана</option>
            <option value="Easy">🟢 Легкая</option>
            <option value="Medium">🟡 Средняя</option>
            <option value="Hard">🔴 Сложная</option>
        </select>
    </div>

    <!-- Возраст -->
    <div Style="margin-bottom:16px;">
        <label Style="display:block; margin-bottom:4px; font-weight:500;">Минимальный возраст</label>
        <input @bind="_template.AgeRestriction" type="number" min="0" max="18" Style="width:100%; padding:8px; border:1px solid #ced4da; border-radius:4px;" placeholder="0 - без ограничений" />
    </div>

    <!-- Дополнительные опции -->
    <div Style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
        <div Style="display:flex; align-items:center; gap:8px;">
            <input @bind="_template.IsPetFriendly" type="checkbox" Style="width:18px; height:18px;" />
            <label Style="margin:0;">🐕 Можно с питомцами</label>
        </div>
        <div Style="display:flex; align-items:center; gap:8px;">
            <input @bind="_template.IsFamilyFriendly" type="checkbox" Style="width:18px; height:18px;" />
            <label Style="margin:0;">👨‍👩‍👧‍👦 Семейное</label>
        </div>
    </div>

    <!-- Снаряжение -->
    <div Style="margin-bottom:16px;">
        <label Style="display:block; margin-bottom:4px; font-weight:500;">Необходимое снаряжение</label>
        <input @bind="_template.RequiredEquipment" Style="width:100%; padding:8px; border:1px solid #ced4da; border-radius:4px;" placeholder="Велосипед, шлем, вода..." />
    </div>

    <!-- Изображение -->
    <div Style="margin-bottom:16px;">
        <label Style="display:block; margin-bottom:4px; font-weight:500;">URL изображения</label>
        <input @bind="_template.ImageUrl" Style="width:100%; padding:8px; border:1px solid #ced4da; border-radius:4px;" placeholder="https://example.com/image.jpg" />
    </div>

    <!-- Приватность -->
    <div Style="margin-bottom:16px; display:flex; align-items:center; gap:12px;">
        <input @bind="_template.IsPrivate" type="checkbox" Style="width:18px; height:18px;" />
        <label Style="font-weight:500;">🔒 Приватное мероприятие</label>
    </div>

    <div Style="display:flex; gap:12px;">
        <button @onclick="HandleSubmit" disabled="@_isSubmitting" Style="flex:1; padding:10px; background:#0078D4; color:white; border:none; border-radius:4px; cursor:pointer; font-size:16px;">
            @if (_isSubmitting)
            {
                <span>⏳ Создание...</span>
            }
            else
            {
                <span>📝 Создать шаблон</span>
            }
        </button>
        <a href="/" Style="display:inline-block; padding:10px 20px; border:1px solid #6c757d; color:#6c757d; border-radius:4px; text-decoration:none;">
            Отмена
        </a>
    </div>
</div>

@code {
    private ActivityTemplate _template = new()
    {
        MaxParticipants = 10,
        Type = ActivityType.Cycling,
        IsRecurring = true,
        CreatedAt = DateTime.Now,
        UpdatedAt = DateTime.Now,
        Tags = new List<string>()
    };

    private string _tagsInput = string.Empty;
    private bool _isAuthenticated;
    private bool _isSubmitting;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = await AuthService.IsAuthenticatedAsync();
    }

    private void AddTag()
    {
        var tags = _tagsInput.Split(',', StringSplitOptions.RemoveEmptyEntries)
                             .Select(t => t.Trim().ToLower())
                             .Where(t => !string.IsNullOrWhiteSpace(t));
        foreach (var tag in tags)
        {
            if (!_template.Tags.Contains(tag))
                _template.Tags.Add(tag);
        }
        _tagsInput = string.Empty;
        StateHasChanged();
    }

    private void RemoveTag(string tag)
    {
        _template.Tags.Remove(tag);
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_template.Title))
        {
            _errorMessage = "❌ Введите название шаблона";
            return;
        }

        if (string.IsNullOrWhiteSpace(_template.Description))
        {
            _errorMessage = "❌ Введите описание";
            return;
        }

        if (string.IsNullOrWhiteSpace(_template.Location))
        {
            _errorMessage = "❌ Укажите место проведения";
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user == null)
            {
                _errorMessage = "❌ Пожалуйста, войдите в систему";
                return;
            }

            _template.OrganizerId = user.Id;
            _template.CreatedAt = DateTime.Now;
            _template.UpdatedAt = DateTime.Now;

            var result = await ActivityService.CreateTemplateAsync(_template);
            Navigation.NavigateTo($"/template/{result.Id}", true);
        }
        catch (Exception ex)
        {
            _errorMessage = $"⚠️ Ошибка: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}