@page "/edit-template/{Id:int}"
@using eMeetup.App.Shared.Models
@using eMeetup.App.Shared.Services
@inject IActivityService ActivityService
@inject IAuthService AuthService
@inject NavigationManager Navigation

@if (_isLoading)
{
    <div Style="text-align:center; padding:40px;">
        <p>⏳ Загрузка...</p>
    </div>
}
else if (_template == null)
{
    <div Style="padding:12px; background:#f8d7da; color:#721c24; border-radius:4px; border:1px solid #f5c6cb;">
        ❌ Шаблон не найден
    </div>
}
else if (!_isOrganizer)
{
    <div Style="padding:12px; background:#fff3cd; color:#856404; border-radius:4px; border:1px solid #ffeeba;">
        ⚠️ Только организатор может редактировать этот шаблон
    </div>
}
else
{
    <div Style="max-width:600px; margin:0 auto; background:white; padding:24px; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,0.1);">
        <h3>✏️ Редактировать шаблон</h3>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div Style="padding:12px; background:#f8d7da; color:#721c24; border-radius:4px; border:1px solid #f5c6cb; margin-bottom:16px;">
                ❌ @_errorMessage
            </div>
        }

        <div Style="margin-bottom:16px;">
            <label Style="display:block; margin-bottom:4px; font-weight:500;">Название *</label>
            <input @bind="_template.Title" Style="width:100%; padding:8px; border:1px solid #ced4da; border-radius:4px;" />
        </div>

        <div Style="margin-bottom:16px;">
            <label Style="display:block; margin-bottom:4px; font-weight:500;">Описание</label>
            <textarea @bind="_template.Description" Style="width:100%; padding:8px; border:1px solid #ced4da; border-radius:4px; min-height:80px;"></textarea>
        </div>

        <div Style="margin-bottom:16px;">
            <label Style="display:block; margin-bottom:4px; font-weight:500;">Тип активности</label>
            <select @bind="_template.Type" Style="width:100%; padding:8px; border:1px solid #ced4da; border-radius:4px;">
                <option value="Cycling">🚴 Вело</option>
                <option value="Hiking">🥾 Поход</option>
                <option value="Bar">🍺 Бар</option>
                <option value="Coffee">☕ Кофе</option>
                <option value="BoardGames">🎲 Настолки</option>
                <option value="Other">📌 Другое</option>
            </select>
        </div>

        <div Style="margin-bottom:16px;">
            <label Style="display:block; margin-bottom:4px; font-weight:500;">Место *</label>
            <input @bind="_template.Location" Style="width:100%; padding:8px; border:1px solid #ced4da; border-radius:4px;" />
        </div>

        <div Style="margin-bottom:16px;">
            <label Style="display:block; margin-bottom:4px; font-weight:500;">Макс. участников</label>
            <input @bind="_template.MaxParticipants" type="number" min="1" max="100" Style="width:100%; padding:8px; border:1px solid #ced4da; border-radius:4px;" />
        </div>

        <div Style="margin-bottom:16px;">
            <label Style="display:block; margin-bottom:4px; font-weight:500;">Сложность</label>
            <select @bind="_template.Difficulty" Style="width:100%; padding:8px; border:1px solid #ced4da; border-radius:4px;">
                <option value="">Не указана</option>
                <option value="Easy">🟢 Легкая</option>
                <option value="Medium">🟡 Средняя</option>
                <option value="Hard">🔴 Сложная</option>
            </select>
        </div>

        <div Style="margin-bottom:16px;">
            <label Style="display:block; margin-bottom:4px; font-weight:500;">URL изображения</label>
            <input @bind="_template.ImageUrl" Style="width:100%; padding:8px; border:1px solid #ced4da; border-radius:4px;" placeholder="https://example.com/image.jpg" />
        </div>

        <div Style="display:flex; gap:12px;">
            <button @onclick="HandleUpdate" disabled="@_isSubmitting" Style="flex:1; padding:10px; background:#0078D4; color:white; border:none; border-radius:4px; cursor:pointer; font-size:16px;">
                @if (_isSubmitting)
                {
                    <span>⏳ Сохранение...</span>
                }
                else
                {
                    <span>💾 Сохранить</span>
                }
            </button>
            <a href="/template/@_template.Id" Style="display:inline-block; padding:10px 20px; border:1px solid #6c757d; color:#6c757d; border-radius:4px; text-decoration:none;">
                Отмена
            </a>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool _isLoading = true;
    private bool _isSubmitting;
    private bool _isOrganizer;
    private ActivityTemplate? _template;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _template = await ActivityService.GetTemplateAsync(Id);

            var user = await AuthService.GetCurrentUserAsync();
            if (user != null && _template != null)
            {
                _isOrganizer = _template.OrganizerId == user.Id;
            }
        }
        catch
        {
            _errorMessage = "Ошибка загрузки шаблона";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleUpdate()
    {
        if (string.IsNullOrWhiteSpace(_template?.Title) || string.IsNullOrWhiteSpace(_template?.Location))
        {
            _errorMessage = "❌ Заполните все обязательные поля";
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            await ActivityService.UpdateTemplateAsync(_template);
            Navigation.NavigateTo($"/template/{_template.Id}", true);
        }
        catch (Exception ex)
        {
            _errorMessage = $"⚠️ Ошибка: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}